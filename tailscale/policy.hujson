{
  "tagOwners": {
    "tag:cm": ["autogroup:admin"],
    "tag:ci": ["autogroup:admin"]
  },

  "autoApprovers": {
    "routes": {
      "10.20.2.0/24": ["tag:cm"]
    }
  },

  "grants": [
    {
      "src": ["autogroup:admin"],
      "dst": ["*"],
      "ip": ["*"]
    },

    {
      "src": ["tag:ci"],
      "dst": ["tag:cm", "10.20.2.0/24"],
      "ip": ["tcp:22", "tcp:443"]
    }
  ],

"ssh": [
    {
      "action": "accept",
      "src": ["tag:ci"],
      "dst": ["tag:cm"],
      "users": ["azureadmin", "root"]
    },
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"]
    }
  ]
}
